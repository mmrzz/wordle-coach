# Copy to .env.development, which Vite loads when running the dev server and
# never when building for production. In production the API is served from the
# same origin as the page, so the base URL is empty and must stay that way:
# a value set here would be baked into the bundle and point the deployed app
# at your laptop. Only VITE_-prefixed vars reach the browser.
VITE_API_URL=http://localhost:8080
